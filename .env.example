# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Only the anon key goes here — it's fine to ship in the browser bundle as long as
# the RLS policy in supabase/knowledge_cards.sql (read-only) is applied. The
# service_role key (used by the bot/Hermes Agent skill to write cards) must NEVER
# go in this file or anywhere in the frontend — it belongs only on the bot's machine.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (optional) — reminders that fire with the tab CLOSED.
# Only the PUBLIC key belongs here. The private key goes to Supabase secrets, never the browser:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
# Generate a fresh pair with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('pub',Buffer.from(publicKey.export({type:'spki',format:'der'}).subarray(-65)).toString('base64url'));console.log('priv',privateKey.export({format:'jwk'}).d)"
VITE_VAPID_PUBLIC_KEY=

# ── Server-only (Vercel → Project → Environment Variables; NOT in .env.local, never VITE_) ──
# App sign-in (plan B0). Leave APP_PASSWORD empty to keep the app open (local dev).
# APP_SECRET is optional — signs the session cookie; defaults to a hash of APP_PASSWORD.
APP_PASSWORD=
APP_SECRET=

# Notion (plan B2): notion.so/profile/integrations → New internal integration → Internal Integration Secret.
# Share the target pages/databases with the integration (page ⋯ → Connections), else search returns nothing.
NOTION_TOKEN=

# Gmail (plan B1): Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI: https://<your-domain>/api/google/callback (and http://localhost:3000/api/google/callback for `vercel dev`).
# Enable the Gmail API. Workspace account → consent screen "Internal" (no verification, refresh tokens never expire).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the refresh token is stored (supabase/integrations.sql). Service key is server-only — never VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public origin override for the OAuth redirect (defaults to the request host).
APP_URL=
